    <comp lib="7" loc="(1065,2805)" name="Text">
      <a name="text" val="se queda; o ilegal; o SYSCALL con $v0=10 -&gt; S_HALT"/>
    </comp>
    <comp lib="7" loc="(1140,635)" name="Text">
      <a name="text" val="tras EXEC -&gt; S_WB"/>
    </comp>
    <comp lib="7" loc="(1150,1840)" name="Text">
      <a name="text" val="DECODE y jal -&gt; S_JAL"/>
    </comp>
    <comp lib="7" loc="(1150,2040)" name="Text">
      <a name="text" val="DECODE y jr -&gt; S_JR"/>
    </comp>
    <comp lib="7" loc="(1155,1640)" name="Text">
      <a name="text" val="DECODE y j -&gt; S_JUMP"/>
    </comp>
    <comp lib="7" loc="(1190,2250)" name="Text">
      <a name="text" val="DECODE y syscall -&gt; S_SYSCALL"/>
    </comp>
    <comp lib="7" loc="(1205,1035)" name="Text">
      <a name="text" val="ADDR y es carga -&gt; S_LOAD"/>
    </comp>
    <comp lib="7" loc="(1210,2490)" name="Text">
      <a name="text" val="SYSCALL con $v0=11 -&gt; S_PRINT"/>
    </comp>
    <comp lib="7" loc="(1215,1250)" name="Text">
      <a name="text" val="ADDR y es almacenamiento -&gt; S_STORE"/>
    </comp>
    <comp lib="7" loc="(1215,1450)" name="Text">
      <a name="text" val="DECODE y beq/bne -&gt; S_BRANCH"/>
    </comp>
    <comp lib="7" loc="(1215,430)" name="Text">
      <a name="text" val="DECODE y clase aritmetica -&gt; S_EXEC"/>
    </comp>
    <comp lib="7" loc="(1215,840)" name="Text">
      <a name="text" val="DECODE y lw/lb/lbu/sw/sb -&gt; S_ADDR"/>
    </comp>
    <comp lib="7" loc="(1220,225)" name="Text">
      <a name="text" val="tras FETCH siempre -&gt; S_DECODE"/>
    </comp>
    <comp lib="7" loc="(1600,80)" name="Text">
      <a name="text" val="LOGICA DE ESTADO SIGUIENTE y clases"/>
    </comp>
    <comp lib="7" loc="(1850,1580)" name="Text">
      <a name="text" val="clase aritmetica"/>
    </comp>
    <comp lib="7" loc="(1850,1670)" name="Text">
      <a name="text" val="clase de memoria"/>
    </comp>
    <comp lib="7" loc="(1850,1760)" name="Text">
      <a name="text" val="destino = rd"/>
    </comp>
    <comp lib="7" loc="(1870,1940)" name="Text">
      <a name="text" val="A de la ALU = registro A"/>
    </comp>
    <comp lib="7" loc="(1880,2040)" name="Text">
      <a name="text" val="A de la ALU = shamt o 16"/>
    </comp>
    <comp lib="7" loc="(1890,2215)" name="Text">
      <a name="text" val="B de la ALU = inmediato sin signo"/>
    </comp>
    <comp lib="7" loc="(1930,1220)" name="Text">
      <a name="text" val="alguno de los 13 estados activo"/>
    </comp>
    <comp lib="7" loc="(1945,2125)" name="Text">
      <a name="text" val="addi/addiu/slti (inmediato con signo)"/>
    </comp>
    <comp lib="7" loc="(1965,1315)" name="Text">
      <a name="text" val="S_FETCH = ninguno activo (estado inicial)"/>
    </comp>
    <comp lib="7" loc="(2300,80)" name="Text">
      <a name="text" val="SENALES DE CONTROL de 1 bit"/>
    </comp>
    <comp lib="7" loc="(2610,680)" name="Text">
      <a name="text" val="RegWrite: WB, LOAD, JAL"/>
    </comp>
    <comp lib="7" loc="(2620,385)" name="Text">
      <a name="text" val="pc_write: FETCH, JUMP, JAL, JR"/>
    </comp>
    <comp lib="7" loc="(2640,495)" name="Text">
      <a name="text" val="IorD: LOAD y STORE usan ALUOut como direccion"/>
    </comp>
    <comp lib="7" loc="(3250,1100)" name="Text">
      <a name="text" val="ALUSrcA"/>
    </comp>
    <comp lib="7" loc="(3250,1670)" name="Text">
      <a name="text" val="ALUSrcB"/>
    </comp>
    <comp lib="7" loc="(3250,2240)" name="Text">
      <a name="text" val="ALUOp"/>
    </comp>
    <comp lib="7" loc="(3250,2560)" name="Text">
      <a name="text" val="PCSrc"/>
    </comp>
    <comp lib="7" loc="(3305,460)" name="Text">
      <a name="text" val="RegDst: 0=rt 1=rd 2=$ra"/>
    </comp>
    <comp lib="7" loc="(3405,780)" name="Text">
      <a name="text" val="MemToReg: 0=ALUOut 1=memoria 2=PC"/>
    </comp>
